# Canal Dark — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves reais

# ─── OPENAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── ELEVENLABS ─────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=nathan  # ou outro voice ID do painel ElevenLabs

# ─── YOUTUBE ─────────────────────────────────────────────────────────────────
# 1. Vá em https://console.cloud.google.com → APIs e Serviços → Credenciais
# 2. Crie OAuth 2.0 Client ID (Tipo: App para Desktop)
# 3. Baixe o JSON e salve como youtube_client_secrets.json na pasta dados/
# 4. Na primeira execução, rode: python scripts/youtube_service.py --auth
YOUTUBE_DATA_API_KEY=...

# ─── REDDIT ──────────────────────────────────────────────────────────────────
# Opcional — o script tem fallback se não tiver credenciais
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=CanalDark/1.0

# ─── CONFIGURAÇÕES DO CANAL ──────────────────────────────────────────────────
CANAL_NOME=Canal Dark
CANAL_ID=UCxxxxxxxxxxxxxxxxx  # ID do seu canal (UC...)
EMAIL_NOTIFICACOES=seu-email@exemplo.com
TIMEZONE=America/Sao_Paulo

# ─── DIRETÓRIOS ─────────────────────────────────────────────────────────────
# Não precisa mudar se usar a estrutura padrão
PROJETOS_DIR=projetos
DADOS_DIR=dados
OUTPUT_DIR=output
